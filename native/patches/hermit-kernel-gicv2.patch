@@ -0,0 +1,270 @@
+//! The generic interrupt controller: a GICv3 (or v4) through `arm-gic`, or a
+//! GICv2.
+//!
+//! The GICv2 driver here is minimal, and does what Linux's does, which runs
+//! both on a GICv2 without the Security Extensions (QEMU `virt` with
+//! `gic-version=2`) and on a hypervisor's virtual CPU interface (libvmm on
+//! seL4): it leaves interrupt groups as they are, acknowledges through
+//! `GICC_IAR` and ends through `GICC_EOIR`, and routes each shared
+//! peripheral interrupt to the CPU that enables it. `arm-gic`'s own GICv2
+//! driver puts every interrupt in Group 1 and uses the aliased registers, which
+//! neither of those delivers.
+//!
+//! The GICv3 path is the one the kernel always had: its CPU interface is
+//! system registers, reached without a lock.
+
+use core::ptr;
+use core::sync::atomic::{AtomicBool, Ordering};
+
+use aarch64_cpu::asm::barrier::{SY, dsb};
+use arm_gic::gicv3::{GicV3, InterruptGroup, SgiTarget, SgiTargetGroup};
+use arm_gic::{IntId, Trigger};
+use memory_addresses::VirtAddr;
+
+/// Whether the interrupt controller is a GICv2, once it is known.
+static IS_V2: AtomicBool = AtomicBool::new(false);
+
+/// The interrupt controller.
+pub(crate) enum Gic {
+	V2(GicV2),
+	V3(GicV3<'static>),
+}
+
+impl Gic {
+	pub(crate) fn v2(gic: GicV2) -> Self {
+		IS_V2.store(true, Ordering::SeqCst);
+		Gic::V2(gic)
+	}
+
+	pub(crate) fn v3(gic: GicV3<'static>) -> Self {
+		IS_V2.store(false, Ordering::SeqCst);
+		Gic::V3(gic)
+	}
+
+	/// The distributor (on the first call) and this CPU's interface.
+	pub(crate) fn setup(&mut self, cpu_id: usize) {
+		match self {
+			Gic::V2(gic) => gic.setup(),
+			Gic::V3(gic) => gic.setup(cpu_id),
+		}
+	}
+
+	pub(crate) fn set_priority_mask(&mut self, mask: u8) {
+		match self {
+			Gic::V2(gic) => gic.set_priority_mask(mask),
+			Gic::V3(_) => GicV3::set_priority_mask(mask),
+		}
+	}
+
+	pub(crate) fn set_interrupt_priority(&mut self, intid: IntId, cpu: Option<usize>, priority: u8) {
+		match self {
+			Gic::V2(gic) => gic.set_interrupt_priority(intid, priority),
+			Gic::V3(gic) => gic.set_interrupt_priority(intid, cpu, priority),
+		}
+	}
+
+	pub(crate) fn set_trigger(&mut self, intid: IntId, cpu: Option<usize>, trigger: Trigger) {
+		match self {
+			Gic::V2(gic) => gic.set_trigger(intid, trigger),
+			Gic::V3(gic) => gic.set_trigger(intid, cpu, trigger),
+		}
+	}
+
+	pub(crate) fn enable_interrupt(&mut self, intid: IntId, cpu: Option<usize>, enable: bool) {
+		match self {
+			Gic::V2(gic) => gic.enable_interrupt(intid, cpu.unwrap_or(0), enable),
+			Gic::V3(gic) => gic.enable_interrupt(intid, cpu, enable),
+		}
+	}
+}
+
+/// An interrupt this CPU acknowledged: its number, and what the controller
+/// returned, which ends it.
+#[derive(Clone, Copy)]
+pub(crate) struct Acknowledged {
+	pub intid: IntId,
+	raw: u32,
+}
+
+/// Acknowledges the highest-priority pending interrupt, if any. Called with
+/// interrupts masked.
+pub(crate) fn acknowledge(gic: &crate::arch::aarch64::kernel::interrupts::GicLock) -> Option<Acknowledged> {
+	if IS_V2.load(Ordering::Relaxed) {
+		let mut guard = gic.lock();
+		match guard.as_mut() {
+			Some(Gic::V2(v2)) => v2.acknowledge(),
+			_ => None,
+		}
+	} else {
+		let intid = GicV3::get_and_acknowledge_interrupt(InterruptGroup::Group1)?;
+		Some(Acknowledged { intid, raw: u32::from(intid) })
+	}
+}
+
+/// Ends an acknowledged interrupt.
+pub(crate) fn end(gic: &crate::arch::aarch64::kernel::interrupts::GicLock, ack: Acknowledged) {
+	if IS_V2.load(Ordering::Relaxed) {
+		let mut guard = gic.lock();
+		if let Some(Gic::V2(v2)) = guard.as_mut() {
+			v2.end(ack);
+		}
+	} else {
+		GicV3::end_interrupt(ack.intid, InterruptGroup::Group1);
+	}
+}
+
+/// Sends the software-generated interrupt `sgi` to CPU `core_id`.
+pub(crate) fn send_sgi(gic: &crate::arch::aarch64::kernel::interrupts::GicLock, sgi: IntId, core_id: u32) {
+	if IS_V2.load(Ordering::Relaxed) {
+		let mut guard = gic.lock();
+		if let Some(Gic::V2(v2)) = guard.as_mut() {
+			v2.send_sgi(sgi, core_id);
+		}
+	} else {
+		GicV3::send_sgi(
+			sgi,
+			SgiTarget::List {
+				affinity3: 0,
+				affinity2: 0,
+				affinity1: 0,
+				target_list: 1 << core_id,
+			},
+			SgiTargetGroup::CurrentGroup1,
+		);
+	}
+}
+
+// ── GICv2 ──────────────────────────────────────────────────────────────
+
+const GICD_CTLR: usize = 0x000;
+const GICD_ISENABLER: usize = 0x100;
+const GICD_ICENABLER: usize = 0x180;
+const GICD_IPRIORITYR: usize = 0x400;
+const GICD_ITARGETSR: usize = 0x800;
+const GICD_ICFGR: usize = 0xc00;
+const GICD_SGIR: usize = 0xf00;
+
+const GICC_CTLR: usize = 0x00;
+const GICC_PMR: usize = 0x04;
+const GICC_IAR: usize = 0x0c;
+const GICC_EOIR: usize = 0x10;
+
+/// Interrupt numbers from here on are special (1020 to 1023: spurious).
+const SPECIAL_START: u32 = 1020;
+
+/// A GICv2: its distributor and this CPU's interface, mapped as device memory.
+pub(crate) struct GicV2 {
+	gicd: VirtAddr,
+	gicc: VirtAddr,
+}
+
+// The registers are reached only through the kernel's lock on the controller.
+unsafe impl Send for GicV2 {}
+
+impl GicV2 {
+	/// # Safety
+	///
+	/// `gicd` and `gicc` map a GICv2's distributor and CPU interface as device
+	/// memory, and nothing else drives them.
+	pub(crate) unsafe fn new(gicd: VirtAddr, gicc: VirtAddr) -> Self {
+		Self { gicd, gicc }
+	}
+
+	fn gicd32(&self, offset: usize) -> *mut u32 {
+		(self.gicd.as_usize() + offset) as *mut u32
+	}
+
+	fn gicd8(&self, offset: usize) -> *mut u8 {
+		(self.gicd.as_usize() + offset) as *mut u8
+	}
+
+	fn gicc32(&self, offset: usize) -> *mut u32 {
+		(self.gicc.as_usize() + offset) as *mut u32
+	}
+
+	fn setup(&mut self) {
+		// SAFETY: the registers are this controller's (`new`).
+		unsafe {
+			// the distributor forwards, and this CPU's interface signals, the
+			// interrupts of the group the controller gives a kernel
+			ptr::write_volatile(self.gicd32(GICD_CTLR), 1);
+			ptr::write_volatile(self.gicc32(GICC_PMR), 0xff);
+			ptr::write_volatile(self.gicc32(GICC_CTLR), 1);
+		}
+		dsb(SY);
+	}
+
+	fn set_priority_mask(&mut self, mask: u8) {
+		// SAFETY: as in `setup`.
+		unsafe { ptr::write_volatile(self.gicc32(GICC_PMR), u32::from(mask)) };
+	}
+
+	fn set_interrupt_priority(&mut self, intid: IntId, priority: u8) {
+		let n = u32::from(intid) as usize;
+		// SAFETY: as in `setup`; one byte per interrupt.
+		unsafe { ptr::write_volatile(self.gicd8(GICD_IPRIORITYR + n), priority) };
+	}
+
+	fn set_trigger(&mut self, intid: IntId, trigger: Trigger) {
+		let n = u32::from(intid) as usize;
+		if n < 16 {
+			// software-generated interrupts are always edge-triggered
+			return;
+		}
+		let reg = self.gicd32(GICD_ICFGR + (n / 16) * 4);
+		let bit = 1u32 << ((n % 16) * 2 + 1);
+		// SAFETY: as in `setup`.
+		unsafe {
+			let v = ptr::read_volatile(reg);
+			let v = match trigger {
+				Trigger::Edge => v | bit,
+				Trigger::Level => v & !bit,
+			};
+			ptr::write_volatile(reg, v);
+		}
+	}
+
+	fn enable_interrupt(&mut self, intid: IntId, cpu: usize, enable: bool) {
+		let n = u32::from(intid) as usize;
+		// SAFETY: as in `setup`.
+		unsafe {
+			if enable && n >= 32 {
+				// a shared peripheral interrupt goes to the CPU that enables it
+				ptr::write_volatile(self.gicd8(GICD_ITARGETSR + n), 1u8 << (cpu & 7));
+			}
+			let reg = if enable { GICD_ISENABLER } else { GICD_ICENABLER };
+			ptr::write_volatile(self.gicd32(reg + (n / 32) * 4), 1u32 << (n % 32));
+		}
+		dsb(SY);
+	}
+
+	fn acknowledge(&mut self) -> Option<Acknowledged> {
+		// SAFETY: as in `setup`.
+		let raw = unsafe { ptr::read_volatile(self.gicc32(GICC_IAR)) };
+		let n = raw & 0x3ff;
+		if n >= SPECIAL_START {
+			return None;
+		}
+		let intid = if n < 16 {
+			IntId::sgi(n)
+		} else if n < 32 {
+			IntId::ppi(n - 16)
+		} else {
+			IntId::spi(n - 32)
+		};
+		Some(Acknowledged { intid, raw })
+	}
+
+	fn end(&mut self, ack: Acknowledged) {
+		// the whole acknowledged value: an SGI's source CPU is part of it
+		// SAFETY: as in `setup`.
+		unsafe { ptr::write_volatile(self.gicc32(GICC_EOIR), ack.raw) };
+	}
+
+	fn send_sgi(&mut self, sgi: IntId, core_id: u32) {
+		let n = u32::from(sgi) & 0xf;
+		dsb(SY);
+		// SAFETY: as in `setup`. Target list filter 0: the listed CPUs.
+		unsafe { ptr::write_volatile(self.gicd32(GICD_SGIR), (1u32 << (16 + (core_id & 7))) | n) };
+	}
+}
