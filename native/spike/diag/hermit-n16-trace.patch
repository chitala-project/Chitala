+/// N1.6 diagnosis (temporary): a ring of scheduler and timer events, each
+/// with the virtual counter, printed when a wakeup comes late.
+pub mod n16 {
+	use aarch64_cpu::registers::*;
+	pub const SET: u8 = 1;
+	pub const IRQ: u8 = 2;
+	pub const BLK: u8 = 3;
+	pub const WAKE: u8 = 4;
+	pub const RDY: u8 = 5;
+	pub const RUN: u8 = 6;
+	pub const MARK: u8 = 7;
+	const N: usize = 16384;
+	static mut RING: [(u8, u64, u64, u64); N] = [(0, 0, 0, 0); N];
+	static mut AT: usize = 0;
+	static mut DUMPS: u32 = 0;
+	static mut READY_AT: [u64; 64] = [0; 64];
+	/// a task became runnable (woken or its time elapsed)
+	pub fn ready(id: u64) {
+		unsafe {
+			if (id as usize) < 64 && READY_AT[id as usize] == 0 {
+				READY_AT[id as usize] = CNTVCT_EL0.get();
+			}
+		}
+	}
+	/// a task is scheduled: dump when it waited more than 20 ms runnable
+	pub fn run(id: u64) {
+		unsafe {
+			if (id as usize) < 64 {
+				let r = READY_AT[id as usize];
+				READY_AT[id as usize] = 0;
+				let now = CNTVCT_EL0.get();
+				if r != 0 && now > r + 1_250_000 {
+					dump("run", now - r);
+				}
+			}
+		}
+	}
+	pub fn now() -> u64 {
+		CNTVCT_EL0.get()
+	}
+	pub fn rec(kind: u8, a: u64, b: u64) {
+		unsafe {
+			let t = CNTVCT_EL0.get();
+			RING[AT % N] = (kind, t, a, b);
+			AT += 1;
+		}
+	}
+	static mut MARK_AT: usize = 0;
+	static mut MARK_DUMPS: u32 = 0;
+	/// the application marks the start of a sample (code 0) or asks for the
+	/// events since that mark (code 2), condensing the timer's storm
+	pub fn mark(code: i32, task: u64) {
+		unsafe {
+			rec(MARK, task, code as u64);
+			if code == 0 {
+				MARK_AT = AT - 1;
+				return;
+			}
+			if code != 2 || MARK_DUMPS >= 4 || AT - MARK_AT >= N {
+				return;
+			}
+			MARK_DUMPS += 1;
+			let (from, to) = (MARK_AT, AT);
+			println!("N16MARK dump from {from} to {to} at {}", CNTVCT_EL0.get());
+			let (mut irq27, mut sets, mut last_cval, mut storm_from) = (0u64, 0u64, u64::MAX, 0u64);
+			for i in MARK_AT..AT {
+				let (k, t, x, y) = RING[i % N];
+				let storm = (k == IRQ && x == 27) || (k == SET && x == last_cval);
+				if storm {
+					if irq27 + sets == 0 {
+						storm_from = t;
+					}
+					if k == IRQ { irq27 += 1 } else { sets += 1 }
+					continue;
+				}
+				if irq27 + sets > 0 {
+					println!("N16MARK storm {storm_from}..{t} irq27 {irq27} set {sets} cval {last_cval}");
+					irq27 = 0;
+					sets = 0;
+				}
+				if k == SET {
+					last_cval = x;
+				}
+				println!("N16MARK {k} {t} {x} {y}");
+			}
+			if irq27 + sets > 0 {
+				println!("N16MARK storm {storm_from}..end irq27 {irq27} set {sets} cval {last_cval}");
+			}
+		}
+	}
+	pub fn dump(why: &str, late: u64) {
+		unsafe {
+			// after the boot, 3 s of the guest's time
+			if DUMPS >= 6 || CNTVCT_EL0.get() < super::BOOT_COUNTER.get().unwrap() + 187_500_000 {
+				return;
+			}
+			DUMPS += 1;
+			println!("N16TRACE dump {why} late {late} at {}", CNTVCT_EL0.get());
+			for i in 0..N {
+				let (k, t, x, y) = RING[(AT + i) % N];
+				if k != 0 {
+					println!("N16TRACE {k} {t} {x} {y}");
+				}
+			}
+		}
+	}
+}
