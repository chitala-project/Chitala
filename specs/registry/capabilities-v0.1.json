{
  "registry": "chitala-core",
  "registry_version": "0.1.4",
  "status": "provisional",
  "capabilities": [
    {
      "id": "device.read_history",
      "version": 1,
      "kind": "query",
      "risk": "medium",
      "description": "What the device's state did over time (spec 29): time in a value, unknown time, entries, the longest run, utilization. Answers from the history; never the history log itself. Medium risk: it shows when people are home.",
      "params": [
        { "name": "key", "type": "text", "max_len": 32, "required": true },
        { "name": "value", "type": "text", "max_len": 64, "required": true },
        { "name": "since_s", "type": "integer", "min": 60, "max": 2592000, "required": true }
      ]
    },
    {
      "id": "device.read_state",
      "version": 1,
      "kind": "query",
      "risk": "low",
      "description": "Read the device's current reported state.",
      "params": []
    },
    {
      "id": "light.turn_on",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Turn the light on.",
      "params": [],
      "outcome": {
        "state": {
          "on": true
        },
        "within_ms": 2000
      }
    },
    {
      "id": "light.turn_off",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Turn the light off.",
      "params": [],
      "outcome": {
        "state": {
          "on": false
        },
        "within_ms": 2000
      }
    },
    {
      "id": "light.set_brightness",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Set the brightness in percent; 0 is equivalent to off.",
      "params": [
        {
          "name": "brightness_pct",
          "type": "integer",
          "min": 0,
          "max": 100,
          "required": true
        }
      ],
      "outcome": {
        "state": {
          "brightness_pct": {
            "param": "brightness_pct"
          }
        },
        "within_ms": 2000
      }
    },
    {
      "id": "switch.turn_on",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Turn the switch/plug on.",
      "params": [],
      "outcome": {
        "state": {
          "on": true
        },
        "within_ms": 2000
      }
    },
    {
      "id": "switch.turn_off",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Turn the switch/plug off.",
      "params": [],
      "outcome": {
        "state": {
          "on": false
        },
        "within_ms": 2000
      }
    },
    {
      "id": "climate.set_target_temperature",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "description": "Set the target temperature (°C, integer). The range [16, 30] is the default safety envelope.",
      "params": [
        {
          "name": "celsius",
          "type": "integer",
          "min": 16,
          "max": 30,
          "required": true
        }
      ],
      "outcome": {
        "state": {
          "target_celsius": {
            "param": "celsius"
          }
        },
        "within_ms": 2000
      }
    },
    {
      "id": "lock.lock",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "description": "Lock the door.",
      "params": [],
      "outcome": {
        "state": {
          "locked": true
        },
        "within_ms": 5000
      }
    },
    {
      "id": "lock.unlock",
      "version": 1,
      "kind": "action",
      "risk": "high",
      "description": "Unlock the door. High risk: an AI's request always needs the approval of an owner of the resource (spec 16).",
      "params": [],
      "outcome": {
        "state": {
          "locked": false
        },
        "within_ms": 5000
      }
    },
    {
      "id": "robot.stop",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Stop the robot now (spec 30). Safety never refuses it, and a right to move a robot includes the right to stop it.",
      "halts": true,
      "params": [],
      "outcome": {
        "state": {
          "motion_state": "stopped"
        },
        "within_ms": 2000
      }
    },
    {
      "id": "robot.move_linear",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "description": "Drive straight along the robot's heading, backwards if the distance is negative. Refused on a stale pose, an obstacle, an emergency stop, outside the geofence or above the resource's speed (spec 30).",
      "params": [
        { "name": "distance_mm", "type": "integer", "min": -10000, "max": 10000, "required": true },
        { "name": "speed_mm_s", "type": "integer", "min": 50, "max": 2000, "required": true }
      ],
      "outcome": {
        "state": {
          "motion_state": "idle"
        },
        "pose": {
          "motion": { "linear": { "distance": "distance_mm", "speed": "speed_mm_s" } },
          "tolerance_mm": 50,
          "tolerance_mdeg": 3000
        },
        "within_ms": 3000
      }
    },
    {
      "id": "robot.rotate",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "description": "Turn on the spot, counter-clockwise if the angle is positive. Refused like any motion (spec 30).",
      "params": [
        { "name": "angle_mdeg", "type": "integer", "min": -720000, "max": 720000, "required": true },
        { "name": "speed_mdeg_s", "type": "integer", "min": 5000, "max": 360000, "required": true }
      ],
      "outcome": {
        "state": {
          "motion_state": "idle"
        },
        "pose": {
          "motion": { "rotate": { "angle": "angle_mdeg", "speed": "speed_mdeg_s" } },
          "tolerance_mm": 30,
          "tolerance_mdeg": 3000
        },
        "within_ms": 3000
      }
    },
    {
      "id": "robot.goto_pose",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "description": "Go to a pose in the map frame: turn towards it, drive straight, turn to its heading. Refused like any motion, and if the straight path leaves the geofence (spec 30).",
      "params": [
        { "name": "x_mm", "type": "integer", "min": -1000000, "max": 1000000, "required": true },
        { "name": "y_mm", "type": "integer", "min": -1000000, "max": 1000000, "required": true },
        { "name": "theta_mdeg", "type": "integer", "min": -180000, "max": 180000, "required": true },
        { "name": "speed_mm_s", "type": "integer", "min": 50, "max": 2000, "required": true }
      ],
      "outcome": {
        "state": {
          "motion_state": "idle"
        },
        "pose": {
          "motion": { "goto": { "x": "x_mm", "y": "y_mm", "theta": "theta_mdeg", "speed": "speed_mm_s" } },
          "tolerance_mm": 100,
          "tolerance_mdeg": 5000
        },
        "within_ms": 10000
      }
    },
    {
      "id": "domain.list_devices",
      "version": 1,
      "kind": "query",
      "risk": "low",
      "target": "domain",
      "description": "List the domain's devices and their capabilities. An AI sees no inventory without a token (v12 §14 selective discovery).",
      "params": []
    },
    {
      "id": "domain.list_approvals",
      "version": 1,
      "kind": "query",
      "risk": "low",
      "target": "domain",
      "description": "List the intents waiting for the caller's decision (the caller must be an owner of the resource).",
      "params": []
    },
    {
      "id": "domain.delegate",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Delegate one capability on one target to another principal (server-mediated). Never amplifies: child ⊆ parent, child window ⊆ parent window, the parent's re-delegation budget, the same or a narrower binding, depth ≤ 3 (v8 §8). The token is bound to the holder's key.",
      "params": [
        {
          "name": "holder",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "target",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "capability",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "ttl_s",
          "type": "integer",
          "min": 1,
          "max": 86400,
          "required": true
        },
        {
          "name": "start_s",
          "type": "integer",
          "min": 0,
          "max": 2592000,
          "required": false
        },
        {
          "name": "redelegate",
          "type": "integer",
          "min": 0,
          "max": 2,
          "required": false
        },
        {
          "name": "for_person",
          "type": "text",
          "max_len": 128,
          "required": false
        },
        {
          "name": "parent_token",
          "type": "text",
          "max_len": 4096,
          "required": false
        }
      ]
    },
    {
      "id": "domain.revoke_token",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Revoke a token (and every token delegated from it). Only an issuer in the chain, an owner or an admin.",
      "params": [
        {
          "name": "revocation_id",
          "type": "text",
          "max_len": 128,
          "required": true
        }
      ]
    },
    {
      "id": "domain.revoke_all",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Raise a revocation floor: every token issued before now that the principal holds, issued or passed on dies at once; without a principal, every token of the domain. Owners and admins for anyone; everyone for themselves.",
      "params": [
        {
          "name": "principal",
          "type": "text",
          "max_len": 128,
          "required": false
        }
      ]
    },
    {
      "id": "domain.safety_hold",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Place a safety hold on a resource and everything in it: no action there until it is released, including orders already in flight (spec 17 SAFE-1).",
      "params": [
        {
          "name": "resource",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "reason",
          "type": "text",
          "max_len": 280,
          "required": false
        }
      ]
    },
    {
      "id": "domain.safety_release",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Release a resource: lift its safety hold and end its recovery after a failed outcome (spec 17 SAFE-1, SAFE-8). Never an AI (C11).",
      "params": [
        {
          "name": "resource",
          "type": "text",
          "max_len": 128,
          "required": true
        }
      ]
    },
    {
      "id": "domain.lease_revoke",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "End an execution lease (spec 21). An owner or an admin, the person it acts for, or one of its approvers; never an AI.",
      "params": [
        {
          "name": "lease_id",
          "type": "text",
          "max_len": 32,
          "required": true
        }
      ]
    },
    {
      "id": "domain.list_leases",
      "version": 1,
      "kind": "query",
      "risk": "low",
      "target": "domain",
      "description": "List the active execution leases the caller may see (spec 21): all of them for owners and admins, otherwise those they use or that act for them.",
      "params": []
    },
    {
      "id": "domain.plan_cancel",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "target": "domain",
      "description": "Cancel a running plan (spec 23): no further step starts, and its order in flight is stopped. The person it acts for, an owner or an admin; never an AI.",
      "params": [
        {
          "name": "plan",
          "type": "text",
          "max_len": 32,
          "required": true
        }
      ]
    },
    {
      "id": "domain.list_plans",
      "version": 1,
      "kind": "query",
      "risk": "low",
      "target": "domain",
      "description": "List the plans the caller may see (spec 23): all of them for owners and admins, otherwise those that act for them.",
      "params": []
    },
    {
      "id": "domain.set_principal_state",
      "version": 1,
      "kind": "action",
      "risk": "high",
      "target": "domain",
      "description": "Move a principal in the security state machine (quarantine/recovery/re-attest). Nobody changes their own state.",
      "params": [
        {
          "name": "principal",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "state",
          "type": "text",
          "max_len": 16,
          "required": true
        }
      ]
    }
  ]
}
