{
  "registry": "chitala-core",
  "registry_version": "0.1.0",
  "status": "provisional",
  "capabilities": [
    {
      "id": "device.read_state",
      "version": 1,
      "kind": "query",
      "risk": "low",
      "description": "Read the device's current reported state.",
      "params": []
    },
    {
      "id": "light.turn_on",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Turn the light on.",
      "params": []
    },
    {
      "id": "light.turn_off",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Turn the light off.",
      "params": []
    },
    {
      "id": "light.set_brightness",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Set the brightness in percent; 0 is equivalent to off.",
      "params": [
        {
          "name": "brightness_pct",
          "type": "integer",
          "min": 0,
          "max": 100,
          "required": true
        }
      ]
    },
    {
      "id": "switch.turn_on",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Turn the switch/plug on.",
      "params": []
    },
    {
      "id": "switch.turn_off",
      "version": 1,
      "kind": "action",
      "risk": "low",
      "description": "Turn the switch/plug off.",
      "params": []
    },
    {
      "id": "climate.set_target_temperature",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "description": "Set the target temperature (°C, integer). The range [16, 30] is the default safety envelope.",
      "params": [
        {
          "name": "celsius",
          "type": "integer",
          "min": 16,
          "max": 30,
          "required": true
        }
      ]
    },
    {
      "id": "lock.lock",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "description": "Lock the door.",
      "params": []
    },
    {
      "id": "lock.unlock",
      "version": 1,
      "kind": "action",
      "risk": "high",
      "description": "Unlock the door. High risk: an AI's request always needs the approval of an owner of the resource (spec 16).",
      "params": []
    },
    {
      "id": "domain.list_devices",
      "version": 1,
      "kind": "query",
      "risk": "low",
      "target": "domain",
      "description": "List the domain's devices and their capabilities. An AI sees no inventory without a token (v12 §14 selective discovery).",
      "params": []
    },
    {
      "id": "domain.list_approvals",
      "version": 1,
      "kind": "query",
      "risk": "low",
      "target": "domain",
      "description": "List the intents waiting for the caller's decision (the caller must be an owner of the resource).",
      "params": []
    },
    {
      "id": "domain.delegate",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Delegate one capability on one target to another principal (server-mediated). Never amplifies: child ⊆ parent, child window ⊆ parent window, the parent's re-delegation budget, the same or a narrower binding, depth ≤ 3 (v8 §8). The token is bound to the holder's key.",
      "params": [
        {
          "name": "holder",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "target",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "capability",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "ttl_s",
          "type": "integer",
          "min": 1,
          "max": 86400,
          "required": true
        },
        {
          "name": "start_s",
          "type": "integer",
          "min": 0,
          "max": 2592000,
          "required": false
        },
        {
          "name": "redelegate",
          "type": "integer",
          "min": 0,
          "max": 2,
          "required": false
        },
        {
          "name": "for_person",
          "type": "text",
          "max_len": 128,
          "required": false
        },
        {
          "name": "parent_token",
          "type": "text",
          "max_len": 4096,
          "required": false
        }
      ]
    },
    {
      "id": "domain.revoke_token",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Revoke a token (and every token delegated from it). Only an issuer in the chain, an owner or an admin.",
      "params": [
        {
          "name": "revocation_id",
          "type": "text",
          "max_len": 128,
          "required": true
        }
      ]
    },
    {
      "id": "domain.revoke_all",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Raise a revocation floor: every token issued before now that the principal holds, issued or passed on dies at once; without a principal, every token of the domain. Owners and admins for anyone; everyone for themselves.",
      "params": [
        {
          "name": "principal",
          "type": "text",
          "max_len": 128,
          "required": false
        }
      ]
    },
    {
      "id": "domain.safety_hold",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Place a safety hold on a resource and everything in it: no action there until it is released, including orders already in flight (spec 17 SAFE-1).",
      "params": [
        {
          "name": "resource",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "reason",
          "type": "text",
          "max_len": 280,
          "required": false
        }
      ]
    },
    {
      "id": "domain.safety_release",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Release a safety hold.",
      "params": [
        {
          "name": "resource",
          "type": "text",
          "max_len": 128,
          "required": true
        }
      ]
    },
    {
      "id": "domain.lease_revoke",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "End an execution lease (spec 21). An owner or an admin, the person it acts for, or one of its approvers; never an AI.",
      "params": [
        {
          "name": "lease_id",
          "type": "text",
          "max_len": 32,
          "required": true
        }
      ]
    },
    {
      "id": "domain.list_leases",
      "version": 1,
      "kind": "query",
      "risk": "low",
      "target": "domain",
      "description": "List the active execution leases the caller may see (spec 21): all of them for owners and admins, otherwise those they use or that act for them.",
      "params": []
    },
    {
      "id": "domain.set_principal_state",
      "version": 1,
      "kind": "action",
      "risk": "high",
      "target": "domain",
      "description": "Move a principal in the security state machine (quarantine/recovery/re-attest). Nobody changes their own state.",
      "params": [
        {
          "name": "principal",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "state",
          "type": "text",
          "max_len": 16,
          "required": true
        }
      ]
    }
  ]
}
