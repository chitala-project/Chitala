      "params": []
    },
    {
      "id": "domain.list_approvals",
      "version": 1,
      "kind": "query",
      "risk": "low",
      "target": "domain",
      "description": "Liệt kê các intent đang chờ chính người gọi phê duyệt (người gọi phải là owner của resource).",
      "params": []
    },
    {
      "id": "domain.delegate",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Ủy quyền một capability trên một target cho principal khác (server-mediated). Không được khuếch đại quyền: child ⊆ parent, expiry con ≤ expiry cha, độ sâu ≤ 3 (v8 §8).",
      "params": [
        {
          "name": "holder",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "target",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "capability",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "ttl_s",
          "type": "integer",
          "min": 1,
          "max": 86400,
          "required": true
        },
        {
          "name": "parent_token",
          "type": "text",
          "max_len": 4096,
          "required": false
        }
      ]
    },
    {
      "id": "domain.revoke_token",
      "version": 1,
      "kind": "action",
      "risk": "medium",
      "target": "domain",
      "description": "Thu hồi token (và mọi token ủy quyền tiếp từ nó). Chỉ người cấp trong chuỗi hoặc owner/admin.",
      "params": [
        {
          "name": "revocation_id",
          "type": "text",
          "max_len": 128,
          "required": true
        }
      ]
    },
    {
      "id": "domain.set_principal_state",
      "version": 1,
      "kind": "action",
      "risk": "high",
      "target": "domain",
      "description": "Chuyển một principal trong Security State Machine (quarantine/recovery/re-attest). Không tự đổi trạng thái của chính mình.",
      "params": [
        {
          "name": "principal",
          "type": "text",
          "max_len": 128,
          "required": true
        },
        {
          "name": "state",
          "type": "text",
          "max_len": 16,
          "required": true
        }
      ]
    }
  ]
